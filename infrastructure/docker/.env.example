# Lila Home v0.1 — 环境变量示例（只放占位符，绝不放真实密码）
# 真实 .env 只存在服务器 /opt/lila-home/infrastructure/docker/.env，绝不进仓库。
# 生成强随机值示例（在服务器上执行，不要把输出贴进聊天）：
#   openssl rand -hex 32

POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_RANDOM_PASSWORD

# JWT 签名密钥（登录用；与上面同样在服务器上生成，只存服务器 .env）
LILA_JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET
